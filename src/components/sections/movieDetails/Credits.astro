---
import {slugify} from "@/lib/helper";
import {imagesUrl} from "@/lib/constant";
import {getCreditData} from "@/lib/getData";

const {mediaType, id} = Astro.props;

let credit = [];
let error = null


try {
    credit = await getCreditData(mediaType, id);
} catch (e: any) {
    console.error(e.message);
    error = e.message
}

const importantCrews = credit?.crew?.filter((crew: any) => crew.job === "Director" || crew.job === "Producer" || crew.job === "Screenplay" || crew.job === "Writer");
---
{
    
    error ? (
        <p>{error}</p> 
    ) : (
        <Fragment>
            <section>
                    <h1 class="text-2xl font-black max-md:mx-6">Cast</h1>
                    <div class="max-w-6xl overflow-auto flex gap-3 py-2 px-6 md:px-0">
                        {
                            credit.cast.map((cast: any) => (
                                <a href={"/celebrity/" + slugify(cast.name) + "-" + cast.id} class="w-28 flex flex-col group outline shadow-[3px_3px_0px_rgba(0,0,0,1)] bg-white" title={cast.name}>
                                    <figure class="w-28">
                                        <img loading="lazy" alt={`cast-pics-${slugify(cast.name)}-${cast.id}`} src={cast.profile_path ? imagesUrl + "w185" + cast.profile_path : "https://placehold.co/96x96?text=No+Data"} class="w-full aspect-square object-cover" width="185" height="auto" transition:name={`poster-${slugify(cast.name)}-${cast.id}`}/>
                                    </figure>
                                    <div class="p-2">
                                        <h2 class="font-bold text-sm group-hover:underline group-hover:underline-offset-2" transition:name={`name-${slugify(cast.name)}-${cast.id}`}>{cast.name}</h2>
                                        <p class="text-xs">{cast.character}</p>
                                    </div>
                                </a>
                            ))
                        }
                    </div>
                </section>
                <section>
                    <h1 class="text-2xl font-black max-md:mx-6">Crews</h1>
                    <div class="max-w-6xl overflow-auto flex gap-3 py-2 px-6 md:px-0">
                        {
                            importantCrews.map((cast: any) => (
                                <div class="w-28 flex flex-col outline shadow-[3px_3px_0px_rgba(0,0,0,1)] bg-white">
                                    <figure class="w-28">
                                        <img loading="lazy" alt={`crew-pics-${slugify(cast.name)}-${cast.id}`} src={cast.profile_path ? imagesUrl + "w185" + cast.profile_path : "https://placehold.co/96x96?text=No+Data"} class="w-full aspect-square object-cover" width="185" height="auto" />
                                    </figure>
                                    <div class="p-2">
                                        <h2 class="font-bold text-sm group-hover:underline group-hover:underline-offset-2">{cast.name}</h2>
                                        <p class="text-xs">{cast.job}</p>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </section>
        </Fragment>
    )
}