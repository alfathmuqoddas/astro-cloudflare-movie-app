---
import {getVideosData} from "@/lib/getData";

const {mediaType, id, slug} = Astro.props;

let videos = [];
let error = null

try {
    videos = await getVideosData(mediaType, id);
} catch (e: any) {
    console.error(e.message);
    error = e.message
}

---
{
    error ? (
        <p>{error}</p>
    ) : (
        <section>
            <h1 class="text-2xl font-black max-md:mx-6">Videos</h1>
            <div class="max-w-6xl overflow-auto flex justify-start gap-2 py-2 px-6 md:px-0">
                {
                    videos.map((video: any, index: number) => (
                        <a class="flex flex-col group cursor-pointer" href={"https://youtube.com/watch?v=" + video.key}>
                            <figure class="relative w-48 aspect-video flex items-center justify-center">
                                <img 
                                    loading="lazy" 
                                    src={`https://img.youtube.com/vi/${video.key}/sddefault.jpg`} 
                                    class="w-full h-full object-cover brightness-75 transition-all group-hover:brightness-50" 
                                    alt={"video-" + slug + "-" + index}
                                />
                                
                                <span class="absolute inset-0 flex items-center justify-center text-white text-3xl">
                                    ▶
                                </span>
                            </figure>
                            
                            <div class="p-2">
                                <p class="font-bold text-sm group-hover:underline group-active:underline underline-offset-2 line-clamp-2">
                                    {video.name}
                                </p>
                            </div>
                        </a>
                    ))
                }
            </div>
        </section>
    )
}