---
import {getPicsData} from "@/lib/getData";
import {imagesUrl} from "@/lib/constant";

const {mediaType, id, slug} = Astro.props;

let pics = [];
let error = null

try {
    pics = await getPicsData(mediaType, id);
} catch (e: any) {
    console.error(e.message);
    error = e.message
}
---
{
    error ? (
        <p>{error}</p>
    ) : (
        <section>
            <h1 class="text-2xl font-black max-md:mx-6">Pictures</h1>
            <div class="max-w-6xl overflow-auto flex gap-2 py-2 px-6 md:px-0">
                {
                    pics?.posters?.map((pic: any, index: number) => (
                        <a class="flex flex-col gap-2 group cursor-pointer" href={imagesUrl + "w185" + pic.file_path}>
                            <figure class="w-32">
                                <img 
                                    loading="lazy" 
                                    src={imagesUrl + "w185" + pic.file_path} 
                                    class="w-full h-full object-cover" 
                                    alt={"pics-" + slug + "-" + index}
                                    width="185"
                                    height="auto"
                                />
                            </figure>
                        </a>
                    ))
                }
            </div>
        </section>
    )
}