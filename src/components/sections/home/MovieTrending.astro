---
import {getTrendingData} from "@/lib/getData";
import {imagesUrl} from "@/lib/constant";
import {slugify} from "@/lib/helper";
import type { TTrendingMovies } from "@/types";

let trendingMovies: TTrendingMovies[] = [];
let error = null

try {
    trendingMovies = await getTrendingData({ timeframe: "week", type: "movie" });
} catch (e: any) {
    console.error(e.message);
    error = e.message
}
---
{
    error ? (
        <p>Error fetching trending movies</p>
    ) : (
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 py-2 gap-1">
            {
                
                trendingMovies.slice(0,12).map((movie: any, index: number) => (
                    <a 
                        class={`
                            ${index === 0 ? "md:col-span-2 md:row-span-2 min-h-75" : "h-auto"} 
                            flex flex-col relative group overflow-hidden
                        `} 
                        href={"/details/movie/" + slugify(movie.title) + "-" + movie.id}
                    >
                        <figure class="w-full h-full relative">
                            <img 
                                src={imagesUrl + "w780" + movie.backdrop_path} 
                                alt={`backdrop-${slugify(movie.title)}-${movie.id}`}
                                class="w-full h-full object-cover"
                                loading={index < 3 ? "eager" : "lazy"}
                                transition:name={`backdrop-${slugify(movie.title)}-${movie.id}`}
                            />

                            <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/40 to-transparent flex flex-col justify-end p-6 md:p-4">
                                <h2 class={`font-heading uppercase leading-tight text-white ${index === 0 ? "text-xl md:text-3xl" : "text-lg"} group-hover:underline group-hover:underline-offset-2`} transition:name={`title-${slugify(movie.title)}-${movie.id}`}>
                                    {movie.title}
                                </h2>
                                {index === 0 && (
                                    <p class="text-xs text-yellow-400 font-bold">FEATURED RELEASE</p>
                                )}
                            </div>
                        </figure>
                    </a>)
                )
            }
        </div>
    )
}
