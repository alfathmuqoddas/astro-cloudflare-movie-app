---
---

<div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 py-2 gap-1">
  {Array.from({ length: 12 }).map((_, index) => (
    <div
      class={`
        ${index === 0 ? "md:col-span-2 md:row-span-2 min-h-75" : "h-auto"} 
        flex flex-col relative group overflow-hidden animate-pulse
      `}
    >
      {/* Figure wrapper */}
      <figure class="w-full h-full relative">
        {/* Image placeholder */}
        <div class="w-full h-full bg-gray-800"></div>

        {/* Overlay placeholder – matches exact padding */}
        <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/40 to-transparent flex flex-col justify-end p-6 md:p-4">
          {/* Title skeleton bars */}
          <div class={`space-y-2 ${index === 0 ? "space-y-3" : ""}`}>
            <div class={`bg-gray-600 rounded ${index === 0 ? "h-5 w-3/4" : "h-4 w-full"}`}></div>
            {index !== 0 && <div class="bg-gray-600 rounded h-4 w-2/3"></div>}
          </div>

          {/* “FEATURED RELEASE” skeleton – only on first item */}
          {index === 0 && (
            <div class="mt-2 bg-yellow-400/30 rounded h-3 w-24"></div>
          )}
        </div>
      </figure>
    </div>
  ))}
</div>