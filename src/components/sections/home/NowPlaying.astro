---
import {getNowPlayingData} from "@/lib/getData";
import {imagesUrl} from "@/lib/constant";
import {slugify} from "@/lib/helper";

let nowPlayingMovies: any[] = [];
let error = null

try {
    nowPlayingMovies = await getNowPlayingData();
} catch (e: any) {
    console.error(e.message);
    error = e.message
}
---
{
    error ? (
        <p>Error fetching now playing movies</p>
    ) : (
        <div class="max-w-6xl overflow-auto flex gap-3 py-2 px-6 md:px-0">
			{
				nowPlayingMovies.map((movie: any) => (
					<a href={"/details/movie/" + slugify(movie.title) + "-" + movie.id} title={movie.title} class="group outline shadow-[3px_3px_0px_rgba(0,0,0,1)] bg-white">
						<figure class="w-32">
							<img width="185" height="auto" src={imagesUrl + "w185" + movie.poster_path} alt={"poster-" + slugify(movie.title)} class="w-full h-full object-cover" transition:name={`poster-${slugify(movie.title)}-${movie.id}`}/>
						</figure>
						<div class="text-center p-2">
						    <h2 class="font-bold text-sm group-hover:underline group-hover:underline-offset-2 line-clamp-3" transition:name={`title-${slugify(movie.title)}-${movie.id}`}>{movie.title}</h2>
						    <p class="text-xs">{movie.release_date.slice(0,4)}</p>
						</div>
					</a>
				))
			}
		</div>
    )
}
