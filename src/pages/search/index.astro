---
import AppLayout from "@/layout/AppLayout.astro";
import MainLayout from "@/layout/MainLayout.astro";
import SearchMovie from "@/components/sections/search/SearchMovies.astro";
import SearchTv from "@/components/sections/search/SearchTv.astro";
import TvTrendingSkeleton from "@/components/sections/home/TvTrendingSkeleton.astro";

const { searchParams } = Astro.url;
const query = searchParams.get("query") || "";
---
<AppLayout>
    <title slot="head">Search Results for {query} | Alfath Muqoddas MovieApp</title>
    <MainLayout>
		<article class="flex flex-col max-md:px-6 gap-8 py-8">
        <h1 class="text-3xl font-bold">Search Results for <i>{query}</i></h1>

        <section>
			<h1 class="text-xl md:text-3xl font-bold">Movies Results</h1>
			<SearchMovie query={query} server:defer>
                <TvTrendingSkeleton slot="fallback" />
            </SearchMovie>
		</section>
    	<section>
			<h1 class="text-xl md:text-3xl font-bold">TV Shows Results</h1>
			<SearchTv query={query} server:defer>
                <TvTrendingSkeleton slot="fallback" />
            </SearchTv>
		</section>
		</article>
    </MainLayout>
</AppLayout>
