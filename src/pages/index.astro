---
import AppLayout from "@/layout/AppLayout.astro";
import MainLayout from "@/layout/MainLayout.astro";
import TrendingMovies from "@/components/sections/home/MovieTrending.astro";
import TrendingMoviesSkeleton from "@/components/sections/home/MovieTrendingSkeleton.astro";
import TrendingTv from "@/components/sections/home/TvTrending.astro";
import TrendingTvSkeleton from "@/components/sections/home/TvTrendingSkeleton.astro";
import NowPlaying from "@/components/sections/home/NowPlaying.astro";
import NowPlayingSkeleton from "@/components/sections/home/NowPlayingSkeleton.astro";
---

<AppLayout>
<title slot="head">Alfath Muqoddas' MovieApp</title>
<meta name="description" content="Astro Cloudflare Movie App by Alfath Muqoddas | MovieApp" slot="head"/>
<!-- opengraph meta tag -->
    <meta property="og:title" content="Alfath Muqoddas' MovieApp" slot="head" />
    <meta property="og:type" content="website" slot="head" />
    <meta property="og:description" content="Astro Cloudflare Movie App by Alfath Muqoddas | MovieApp" slot="head" />
    <meta property="og:url" content={Astro.url.origin} slot="head" />
<!-- twitter meta tag -->
    <meta name="twitter:card" content="summary_large_image" slot="head" />
    <meta name="twitter:title" content="Alfath Muqoddas' MovieApp" slot="head"/>
    <meta name="twitter:description" content="Astro Cloudflare Movie App by Alfath Muqoddas | MovieApp" slot="head"/>
    <meta name="twitter:url" content={Astro.url.origin} slot="head"/>
<MainLayout>
	<article class="flex flex-col gap-8 mt-6">
	<section>
		<h1 class="text-xl md:text-3xl font-bold max-md:pl-6">Trending Movies</h1>
		<TrendingMovies server:defer>
            <TrendingMoviesSkeleton slot="fallback" />
        </TrendingMovies>
	</section>

	<section class="max-md:px-6">
		<h1 class="text-xl md:text-3xl font-bold">Trending TV Shows</h1>
		<TrendingTv server:defer>
            <TrendingTvSkeleton slot="fallback" />
        </TrendingTv>
	</section>

	<section>
		<h1 class="text-xl md:text-3xl font-bold max-md:pl-6">Now Playing</h1>
		<NowPlaying server:defer>
            <NowPlayingSkeleton slot="fallback" />
        </NowPlaying>
	</section>
	</article>
</MainLayout>
</AppLayout>