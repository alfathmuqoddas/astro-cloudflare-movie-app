---
import AppLayout from "@/layout/AppLayout.astro";
import MainLayout from "@/layout/MainLayout.astro";
import { getMediaDetails  } from "@/lib/getData";
import {imagesUrl} from "@/lib/constant";
import {extractSlug} from "@/lib/helper";
import MediaDetails from "@/components/sections/movieDetails/MediaDetails.astro";
import Credits from "@/components/sections/movieDetails/Credits.astro";
import Videos from "@/components/sections/movieDetails/Videos.astro";
import Pictures from "@/components/sections/movieDetails/Pictures.astro";
import Similar from "@/components/sections/movieDetails/Similar.astro";
import NowPlayingSkeleton from "@/components/sections/home/NowPlayingSkeleton.astro";

const { mediaType, slug } = Astro.params;


if (!mediaType || !slug) {
  return Astro.redirect('/404');
}

if (mediaType !== 'movie' && mediaType !== 'tv') {
  return Astro.redirect('/404');
}

const id = extractSlug(slug);

let mediaDetails = [];
let error = null

try {
    mediaDetails = await getMediaDetails(mediaType, id);
} catch (e: any) {
    console.error(e.message);
    error = e.message
}

---
<AppLayout>
    <Fragment slot="head">
        <title>{mediaDetails.title || mediaDetails.name} | Alfath Muqoddas MovieApp</title>
        <meta name="description" content={mediaDetails.overview + " | Alfath Muqoddas | MovieApp"}/>
        <!-- opengraph meta -->
        <meta property="og:title" content={mediaDetails.title || mediaDetails.name + " | Alfath Muqoddas | MovieApp"} />
        <meta property="og:type" content="div" slot="head" />
        <meta property="og:description" content={mediaDetails.overview + " " + "Alfath Muqoddas | MovieApp"} />
        <meta property="og:image" content={imagesUrl + "w300" + mediaDetails.poster_path}/>
        <meta property="og:url" content={Astro.url.href} slot="head" />
        <!-- twitter meta -->
        <meta name="twitter:card" content="summary_large_image" slot="head" />
        <meta name="twitter:title" content={mediaDetails.title || mediaDetails.name + " | Alfath Muqoddas | MovieApp"}/>
        <meta name="twitter:description" content={mediaDetails.overview + " " + "Alfath Muqoddas | MovieApp"}/>
        <meta name="twitter:image" content={imagesUrl + "w300" + mediaDetails.poster_path}/>
        <meta name="twitter:url" content={Astro.url.href} slot="head"/>
    </Fragment>
    <MainLayout>
        <article class="flex flex-col gap-8 pb-8">
        
        {error ? <>Error fetching media details</> : (
            <MediaDetails mediaDetails={mediaDetails} slug={slug} mediaType={mediaType} />
        )}
        
        <Credits mediaType={mediaType} id={id} server:defer>
            <NowPlayingSkeleton slot="fallback" />
        </Credits>

        <Videos mediaType={mediaType} id={id} slug={slug} server:defer>
            <p class="max-md:mx-6" slot="fallback">Loading...</p>
        </Videos>

        <Pictures mediaType={mediaType} id={id} slug={slug} server:defer>
            <p class="max-md:mx-6" slot="fallback">Loading...</p>
        </Pictures>

        <Similar mediaType={mediaType} id={id} server:defer>
            <p class="max-md:mx-6" slot="fallback">Loading...</p>
        </Similar>
        
        </article>
    </MainLayout>
</AppLayout>